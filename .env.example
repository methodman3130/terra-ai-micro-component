# Copy to .env and fill in. .env is gitignored and must never be committed.
POSTGRES_USER=terra
POSTGRES_PASSWORD=change-me-before-first-run
POSTGRES_DB=terra

# The API should use a least-privilege role, not the owner above.
# CREATE ROLE terra_api LOGIN PASSWORD '...';
# GRANT CONNECT ON DATABASE terra TO terra_api;
# GRANT USAGE ON SCHEMA public TO terra_api;
# GRANT SELECT ON ALL TABLES IN SCHEMA public TO terra_api;
TERRA_DATABASE_URL=postgresql+psycopg://terra_api:change-me@localhost:5432/terra

TERRA_OPENSTAT_BASE=https://openstat.psa.gov.ph/PXWeb/api/v1/en
TERRA_RAW_DIR=./data/raw
TERRA_STUDY_CUTOFF=2025-12-31
TERRA_CORS_ORIGINS=http://localhost:5173

# Required. The API refuses to start without it; a default signing key would be
# the same as no authentication at all.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
TERRA_JWT_SECRET=
